# Export the settings you need before starting the backend.
# The studio does not automatically load .env files.

# Scene author: exactly gpt-6-astra through the saved Codex login or OpenAI API.
# For subscription access, install Codex CLI and run codex login with ChatGPT.
# Codex manages its credentials; do not copy a subscription token into this file.
# auto prefers the saved Codex ChatGPT login; codex/openai choose a default.
# Each draft preserves its selected provider.
# STUDIO_AUTHOR_PROVIDER=auto
# STUDIO_CODEX_PATH=/absolute/path/to/codex

# API scene author. Requires API access to gpt-6-astra.
# OPENAI_API_KEY=
# Optional author-specific key overrides OPENAI_API_KEY:
# STUDIO_AUTHOR_API_KEY=

# VLM judge: choose the connection and model in the Judges UI.
# Codex subscription judges use the same saved login and exact gpt-6-astra.
# An API judge instead uses this full chat-completions endpoint and optional token:
# STUDIO_JUDGE_ENDPOINT=https://your-provider.example/v1/chat/completions
# STUDIO_JUDGE_TOKEN=

# Optional pretrained ICRT worker. See integrations/icrt/README.md for preparation.
# The backend defaults to this local address; start the worker separately.
# STUDIO_ICRT_ENDPOINT=http://127.0.0.1:8790
# For a remote worker, export the same token in BOTH backend and worker environments.
# The worker requires a token when binding beyond localhost.
# STUDIO_ICRT_TOKEN=

# Optional override for the prepared MuJoCo Menagerie Panda asset directory.
# The default is .data/models/menagerie/franka_emika_panda in this repository.
# This directory must contain panda.xml and its assets/ folder.
# STUDIO_FRANKA_ASSETS=/absolute/path/to/franka_emika_panda

# Another robotics service implementing docs/adapter-protocol.md:
# STUDIO_ROBOT_ENDPOINT=http://127.0.0.1:9000
# STUDIO_ROBOT_TOKEN=

# Local metadata, references, and recordings. Defaults to .data/ in this repository.
# Downloaded ICRT and Menagerie assets have their own preparation paths.
# STUDIO_DATA_DIR=/absolute/path/to/studio-data

# Headless Linux: select an installed MuJoCo renderer, such as egl or osmesa.
# MUJOCO_GL=egl

# Private Runpod studio through an SSH tunnel. Set only on the cloud backend.
# STUDIO_UI_ORIGIN=http://127.0.0.1:8789

# Optional Blender authoring. Install with uv sync --project integrations/blender.
# Default: integrations/blender/.venv/bin/python, launched per build.
# STUDIO_BLENDER_PYTHON=/absolute/path/to/blender-python/bin/python
